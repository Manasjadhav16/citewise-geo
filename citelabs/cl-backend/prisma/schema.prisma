generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "postgresql"
  url          = env("DATABASE_URL")
  directUrl    = env("DIRECT_URL")
  relationMode = "prisma"
}

model CitelabsPage {
  id        BigInt   @id @default(autoincrement())
  url       String
  content   String?
  aiSummary String?  @map("ai_summary")
  pageType  String?  @map("page_type")
  isClient  Boolean  @default(false) @map("is_client")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("citelabs_pages")
}

model PageRecord {
  id                  String   @id @default(cuid())
  url                 String   @unique
  pageType            String?
  title               String?
  metaDescription     String?
  headings            String?
  mainContent         String?
  lastModified        String?
  pagePurposeSummary  String?
  primaryKeywordGuess String?
  aiSummary           String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @default(now()) @updatedAt
}

model SandboxRun {
  id          String              @id @default(cuid())
  sandboxUrl  String              @map("sandbox_url")
  status      String
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @default(now()) @updatedAt @map("updated_at")
  pages       SandboxPage[]
  questions   SandboxQuestion[]
  competitors SandboxCompetitor[]
  ragResults  SandboxRagResult[]
  scores      SandboxScore?
  events      JobEvent[]
  chatSessions ChatSession[]       // Link to chat sessions

  // Two-stage GEO
  observationId String?  @map("observation_id")   // Stage 1 observation this run was seeded from
  runTag        String?  @map("run_tag")          // before | after
  baselineRunId String?  @map("baseline_run_id")  // for "after" runs
  seedMode      String?  @map("seed_mode")        // stage1 | baseline | null (unseeded)
  questionSet   Json?    @map("question_set")     // exact questions asked (reused by "after" runs)
  sourcePool    Json?    @map("source_pool")      // exact source pool crawled (reused by "after" runs)
  poolCounts    Json?    @map("pool_counts")

  @@index([observationId])
  @@index([baselineRunId])

  @@map("sandbox_runs")
}

model SandboxPage {
  id                 String     @id @default(cuid())
  runId              String     @map("run_id")
  url                String
  title              String?
  h1                 String?
  intent             String?
  pageSummary        String?    @map("page_summary")
  aiSummary          String?
  fullText           String?    @map("full_text")
  isClient           Boolean    @default(true) @map("is_client")
  createdAt          DateTime   @default(now()) @map("created_at")
  updatedAt          DateTime   @default(now()) @updatedAt @map("updated_at")
  sandboxBrandName   String?    @map("sandbox_brand_name")
  run                SandboxRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@map("sandbox_pages")
}

model AnswerMetrics {
  id                      String           @id @default(cuid())
  answerId                String           @unique @map("answer_id")
  brandMentionCount       Int              @default(0) @map("brand_mention_count")
  competitorMentionCount  Int              @default(0) @map("competitor_mention_count")
  isBrandMentioned        Boolean          @default(false) @map("is_brand_mentioned")
  isBrandCited            Boolean          @default(false) @map("is_brand_cited")
  brandCitedFirst         Boolean          @default(false) @map("brand_cited_first")
  createdAt               DateTime         @default(now()) @map("created_at")
  answer                  SandboxRagResult @relation(fields: [answerId], references: [id], onDelete: Cascade)

  @@map("answer_metrics")
}

model SandboxQuestion {
  id         String             @id @default(cuid())
  runId      String             @map("run_id")
  type       String
  question   String
  createdAt  DateTime           @default(now()) @map("created_at")
  run        SandboxRun         @relation(fields: [runId], references: [id], onDelete: Cascade)
  ragResults SandboxRagResult[]

  @@map("sandbox_questions")
}

model SandboxCompetitor {
  id         String     @id @default(cuid())
  runId      String     @map("run_id")
  url        String
  domain     String
  title      String?
  h1         String?
  aiSummary  String?
  fullText   String?    @map("full_text")
  sourceType String     @default("competitor") @map("source_type")
  domainType String?    @default("editorial") @map("domain_type")
  sourceCategory  String? @map("source_category")   // two-stage GEO category (Stage 1's when seeded)
  competitorGroup String? @map("competitor_group")  // target | direct_business | ai_visibility
  categorySource  String? @map("category_source")
  origin          String?                           // stage1 | discovery
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @default(now()) @updatedAt @map("updated_at")
  run        SandboxRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@map("sandbox_competitors")
}

model SandboxChunk {
  id         String   @id @default(cuid())
  runId      String   @map("run_id")
  url        String
  chunkId    Int      @map("chunk_id")
  text       String
  summary    String?
  isClient   Boolean  @default(false) @map("is_client")
  domain     String?
  sourceType String   @default("competitor") @map("source_type")
  domainType String?  @default("editorial") @map("domain_type")
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([runId, url, chunkId])
  @@map("sandbox_chunks")
}

model SandboxRagResult {
  id                        String          @id @default(cuid())
  runId                     String          @map("run_id")
  questionId                String          @map("question_id")
  question                  String
  answer                    String
  didSandboxAppear          Boolean         @default(false) @map("did_sandbox_appear")
  chunksUsed                Int             @default(0) @map("chunks_used")
  confidence                Float?
  competitorCitations       String[]        @map("competitor_citations")
  sandboxCitations          String[]        @map("sandbox_citations")
  businessCompetitorCitations String[]      @map("business_competitor_citations")
  authoritySourceCitations  String[]       @map("authority_source_citations")
  diagnosisType             String?         @map("diagnosis_type")
  diagnosisDetail           String?         @map("diagnosis_detail")
  sandboxCitationPosition   Int?            @map("sandbox_citation_position")
  citedSourceCategories     Json?           @map("cited_source_categories")
  retrievedSourceCategories Json?           @map("retrieved_source_categories")
  createdAt                 DateTime        @default(now()) @map("created_at")
  run                       SandboxRun      @relation(fields: [runId], references: [id], onDelete: Cascade)
  questionRef               SandboxQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  metrics                   AnswerMetrics?

  @@map("sandbox_rag_results")
}

model SandboxScore {
  id                  String     @id @default(cuid())
  runId               String     @unique @map("run_id")
  geoScore            Float      @map("geo_score")
  aeoScore            Float      @map("aeo_score")
  citationRate        Float      @map("citation_rate")
  coverage            Float?
  competitorDominance Float?     @map("competitor_dominance")
  missingContent      String[]   @map("missing_content")
  schemaGaps          String[]   @map("schema_gaps")
  structuredDataOps   String[]   @map("structured_data_ops")
  recommendations     String[]
  // Two-stage GEO metrics (GEO/AEO formulas and citationRate above are unchanged)
  responsesEvaluated       Int?   @map("responses_evaluated")
  mentionRate              Float? @map("mention_rate")
  strictCitationRate       Float? @map("strict_citation_rate")
  meanCitationPosition     Float? @map("mean_citation_position")
  medianCitationPosition   Float? @map("median_citation_position")
  categoryBreakdown        Json?  @map("category_breakdown")
  competitorGroupBreakdown Json?  @map("competitor_group_breakdown")
  createdAt           DateTime   @default(now()) @map("created_at")
  updatedAt           DateTime   @default(now()) @updatedAt @map("updated_at")
  run                 SandboxRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@map("sandbox_scores")
}

model JobEvent {
  id        String     @id @default(cuid())
  eventId   String     @unique @map("event_id")
  runId     String     @map("run_id")
  step      String
  status    String
  payload   Json?
  timestamp DateTime   @default(now())
  run       SandboxRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@index([eventId])
  @@map("job_events")
}

// ==========================================
// Chat Interface Models
// ==========================================

model ChatSession {
  id        String        @id @default(cuid())
  userId    String        @map("user_id") // For v1: simple string, future: foreign key to User
  title     String?       // Auto-generated from first message if null
  scope     String        // "sandbox_only" | "sandbox_competitors" | "web_only"
  runId     String?       @map("run_id") // Optional link to SandboxRun
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @default(now()) @updatedAt @map("updated_at")
  deletedAt DateTime?     @map("deleted_at") // Soft delete
  
  messages  ChatMessage[]
  run       SandboxRun?   @relation(fields: [runId], references: [id], onDelete: SetNull)
  
  @@index([userId, deletedAt])
  @@index([runId])
  @@map("chat_sessions")
}

model ChatMessage {
  id        String         @id @default(cuid())
  sessionId String         @map("session_id")
  role      String         // "user" | "assistant"
  content   String         // Message text
  tokensIn  Int?           @map("tokens_in")
  tokensOut Int?           @map("tokens_out")
  modelUsed String?        @map("model_used") // "gemini-2.5-flash"
  latencyMs Int?           @map("latency_ms") // Response latency in milliseconds
  createdAt DateTime       @default(now()) @map("created_at")
  
  session   ChatSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  citations ChatCitation[]
  
  @@index([sessionId, createdAt])
  @@map("chat_messages")
}

model ChatCitation {
  id             String      @id @default(cuid())
  messageId      String      @map("message_id")
  url            String
  domainType     String?     @map("domain_type") // "sandbox_brand" | "business_competitor" | "editorial"
  chunkId        Int?        @map("chunk_id")
  relevanceScore Float?     @map("relevance_score")
  createdAt      DateTime    @default(now()) @map("created_at")
  
  message        ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  
  @@index([messageId])
  @@map("chat_citations")
}

model UsageLog {
  id            String   @id @default(cuid())
  userId       String   @map("user_id")
  date         DateTime  @db.Date // Date only (no time)
  tokensUsed   Int      @default(0) @map("tokens_used")
  messagesCount Int     @default(0) @map("messages_count")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")
  
  @@unique([userId, date])
  @@index([userId, date])
  @@map("usage_logs")
}

// ==========================================
// Stage 1: Real-World Observation
// ==========================================
// Repeated search-grounded answers per query and the sources they cite.
// The default fetcher (Gemini + Google Search grounding) is an approximate
// proxy for Google AI Overview citations, NOT real AI Overview data.

model ObservationRun {
  id               String   @id @default(cuid())
  sandboxUrl       String   @map("sandbox_url")
  status           String // pending | running | completed | failed
  fetcher          String?
  dataDisclaimer   String?  @map("data_disclaimer")
  config           Json? // runs_per_query, query_count, token budgets, taxonomy, ...
  context          Json? // brand, business category, page intent, domain summary
  requestedQueries String[] @map("requested_queries")
  error            String?

  // Run-level aggregates
  runsAttempted            Int?   @map("runs_attempted")
  runsSucceeded            Int?   @map("runs_succeeded")
  uniqueSources            Int?   @map("unique_sources")
  uniqueDomains            Int?   @map("unique_domains")
  mentionRate              Float? @map("mention_rate")
  citationRate             Float? @map("citation_rate")
  meanCitationPosition     Float? @map("mean_citation_position")
  medianCitationPosition   Float? @map("median_citation_position")
  meanSourceSetDiversity   Float? @map("mean_source_set_diversity")
  meanSourceSetStability   Float? @map("mean_source_set_stability")
  meanDomainSetStability   Float? @map("mean_domain_set_stability")
  categoryBreakdown        Json?  @map("category_breakdown") // % of citations per category
  competitorGroupBreakdown Json?  @map("competitor_group_breakdown") // target / direct_business / ai_visibility
  sourceCategories         Json?  @map("source_categories") // per domain: final, llm and heuristic labels
  // Fetcher provenance and AI Overview activation (serpapi_aio); rates above are over runs with an AI answer
  fetcherSettings          Json?  @map("fetcher_settings") // e.g. gl / hl / device for serpapi_aio
  preflight                Json? // e.g. SerpApi searches left before the run
  creditsUsed              Int?   @map("credits_used")
  ratesBasedOnRuns         Int?   @map("rates_based_on_runs")
  aioRuns                  Int?   @map("aio_runs")
  aioActivationRate        Float? @map("aio_activation_rate")
  overallCitationRate      Float? @map("overall_citation_rate") // cited / all successful runs
  parseErrors              Int?   @map("parse_errors")
  inlineLinkedRuns         Int?   @map("inline_linked_runs") // secondary: answers linking the target inline (not citations)
  inlineLinkRate           Float? @map("inline_link_rate")

  createdAt DateTime           @default(now()) @map("created_at")
  updatedAt DateTime           @default(now()) @updatedAt @map("updated_at")
  queries   ObservationQuery[]
  events    ObservationEvent[]

  @@map("observation_runs")
}

model ObservationQuery {
  id            String  @id @default(cuid())
  observationId String  @map("observation_id")
  queryIndex    Int     @map("query_index")
  query         String
  queryType     String? @map("query_type")

  successfulRuns         Int    @default(0) @map("successful_runs")
  sourceSetDiversity     Int?   @map("source_set_diversity")
  domainDiversity        Int?   @map("domain_diversity")
  sourceSetStability     Float? @map("source_set_stability") // mean pairwise Jaccard, URLs
  domainSetStability     Float? @map("domain_set_stability") // mean pairwise Jaccard, domains
  mentionRate            Float? @map("mention_rate")
  citationRate           Float? @map("citation_rate")
  meanCitationPosition   Float? @map("mean_citation_position")
  medianCitationPosition Float? @map("median_citation_position")
  targetEvidence         Json?  @map("target_evidence") // sandbox page's evidence for this query
  ratesBasedOnRuns       Int?   @map("rates_based_on_runs")
  aioRuns                Int?   @map("aio_runs")
  aioActivationRate      Float? @map("aio_activation_rate")
  overallCitationRate    Float? @map("overall_citation_rate")
  creditsUsed            Int?   @map("credits_used")
  parseErrors            Int?   @map("parse_errors")
  inlineLinkedRuns       Int?   @map("inline_linked_runs")
  inlineLinkRate         Float? @map("inline_link_rate")

  observation ObservationRun        @relation(fields: [observationId], references: [id], onDelete: Cascade)
  responses   ObservationResponse[]
  sources     ObservationSource[]

  @@index([observationId])
  @@map("observation_queries")
}

// One observed answer: query x run index
model ObservationResponse {
  id              String   @id @default(cuid())
  observationId   String   @map("observation_id")
  queryId         String   @map("query_id")
  runIndex        Int      @map("run_index")
  ok              Boolean
  error           String?
  model           String?
  latencySeconds  Float?   @map("latency_seconds")
  answerText      String?  @map("answer_text")
  searchQueries   String[] @map("search_queries")
  targetMentioned Boolean? @map("target_mentioned")
  targetCited     Boolean? @map("target_cited")
  targetPosition  Int?     @map("target_position")
  outcome         String? // answer | no_aio | error
  creditsUsed     Int?     @map("credits_used")
  fetchMeta       Json?    @map("fetch_meta") // fetcher settings, engines called, search ids
  parseError         String?  @map("parse_error")
  tablesSeen         Int?     @map("tables_seen")
  raggedTable        Boolean? @map("ragged_table") // a table row had fewer cells than its header
  snippetLinks       Json?    @map("snippet_links") // inline links in the answer text; not citations
  targetInlineLinked Boolean? @map("target_inline_linked")
  rawResponses       Json?    @map("raw_responses") // sanitized raw API responses, in call order

  query     ObservationQuery      @relation(fields: [queryId], references: [id], onDelete: Cascade)
  citations ObservationCitation[]

  @@index([queryId])
  @@index([observationId])
  @@map("observation_responses")
}

// Raw per-run citation list (kept for stability / Jaccard analysis)
model ObservationCitation {
  id            String  @id @default(cuid())
  responseId    String  @map("response_id")
  position      Int // 1-based: cited-in-answer sources first, by first appearance
  rawUri        String  @map("raw_uri")
  url           String?
  domain        String
  title         String?
  citedInAnswer Boolean @map("cited_in_answer")
  isWebSource   Boolean @map("is_web_source")

  response ObservationResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)

  @@index([responseId])
  @@index([domain])
  @@map("observation_citations")
}

// Union source pool per query, with category and evidence
model ObservationSource {
  id                     String   @id @default(cuid())
  observationId          String   @map("observation_id")
  queryId                String   @map("query_id")
  sourceKey              String   @map("source_key")
  url                    String?
  domain                 String
  title                  String?
  category               String
  categorySource         String   @map("category_source") // target_domain_match | llm | heuristic | fallback
  llmCategory            String?  @map("llm_category")
  heuristicCategory      String?  @map("heuristic_category")
  competitorGroup        String   @map("competitor_group") // target | direct_business | ai_visibility
  stability              Float // appearances / N
  appearances            Int
  overSourceCap          Boolean  @default(false) @map("over_source_cap")
  crawlError             String?  @map("crawl_error")
  evidence               String?
  evidenceTokenBudget    Int?     @map("evidence_token_budget")
  evidenceTokenEstimate  Int?     @map("evidence_token_estimate")
  hasRelevantEvidence    Boolean? @map("has_relevant_evidence")
  evidenceError          String?  @map("evidence_error")
  evidenceLatencySeconds Float?   @map("evidence_latency_seconds")

  query ObservationQuery @relation(fields: [queryId], references: [id], onDelete: Cascade)

  @@index([queryId])
  @@index([observationId])
  @@index([domain])
  @@map("observation_sources")
}

model ObservationEvent {
  id            String         @id @default(cuid())
  eventId       String         @unique @map("event_id")
  observationId String         @map("observation_id")
  step          String
  status        String
  payload       Json?
  timestamp     DateTime       @default(now())
  observation   ObservationRun @relation(fields: [observationId], references: [id], onDelete: Cascade)

  @@index([observationId])
  @@map("observation_events")
}
